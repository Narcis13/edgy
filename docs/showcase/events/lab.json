{
  "title": "Events lab",
  "ops": [
    ["meta", "on.open", ["set!", "opens", ["+", "$opens", 1]]],
    ["meta", "actions.greet", ["fn", ["who", "mark"], ["set!", "hello", ["str", "Hi ", "$who", ["default", "$mark", "."]]]]]
  ],
  "root": ["col",
    ["text", {"style": {"size": 22, "weight": 650}}, "Events lab · opened {{opens}} times"],
    ["row",
      ["input", {"name": "agree", "type": "checkbox", "label": "I agree", "value": false,
        "on": {"change": ["do", ["set!", "status", ["if", "$value", "Agreed", "Not yet"]], ["set!", "flips", ["+", "$flips", 1]]]}}],
      ["text", {"name": "clicker", "on": {"click": ["set!", "clicks", ["+", "$clicks", 1]], "dblclick": ["set!", "doubles", ["+", "$doubles", 1]]}}, "Click or double-click me ({{clicks}} / {{doubles}})"],
      ["image", {"name": "pic", "src": "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='80' height='40'><rect width='80' height='40' fill='%2390c'/></svg>", "on": {"click": ["set!", "lastClick", "$target"]}}]],
    ["table", {"name": "people", "value": [{"name": "Ann", "age": 31}, {"name": "Bo", "age": 27}],
      "on": {"click": ["set!", "lastClick", ["get", "$row", "name"]], "dblclick": ["set!", "lastDouble", ["get", "$row", "name"]]}}],
    ["row",
      ["button", {"name": "stopper", "do": ["stop!", "poll"]}, "Stop the timer"],
      ["button", {"name": "starter", "do": ["start!", "poll"]}, "Start it"],
      ["button", {"name": "shout", "do": ["emit!", "saved", {"total": 42}]}, "Emit saved"],
      ["button", {"name": "greetAnn", "do": ["greet", "Ann"]}, "Greet Ann"],
      ["button", {"name": "greetBo", "do": ["greet", "Bo", "!"]}, "Greet Bo"],
      ["button", {"name": "broken", "do": ["grete", "Cy"]}, "Broken"],
      ["button", {"name": "loop", "do": ["set!", "spin", 1]}, "Loop"],
      ["button", {"name": "refresher", "do": ["refresh!", "rate"]}, "Refresh rate"]],
    ["fetch", {"name": "rate", "label": "Exchange rate", "on": {"load": ["set!", "seen", ["get", "$data", "rate"]]}}, "/api/demo/rate"],
    ["fetch", {"name": "down", "on": {"fail": ["set!", "why", "$message"]}}, "/api/demo/fail"],
    ["fetch", {"name": "gone", "on": {"fail": ["set!", "why2", "$message"]}}, "https://unreachable.invalid/rate.json"],
    ["text", "Rate {{(get rate \"rate\")}} · status {{(status rate)}} · {{status}} · flips {{flips}} · ticks {{ticks}} · once {{once}} · hello {{hello}} · got {{a}} / {{b}} · last {{lastClick}} / {{lastDouble}}"],
    ["timer", {"name": "poll", "every": 2, "on": {"tick": ["set!", "ticks", ["+", "$ticks", 1]]}}],
    ["timer", {"name": "later", "after": 3, "on": {"tick": ["set!", "once", ["+", "$once", 1]]}}],
    ["data", {"name": "opens"}, 0], ["data", {"name": "status"}, ""], ["data", {"name": "flips"}, 0],
    ["data", {"name": "clicks"}, 0], ["data", {"name": "doubles"}, 0], ["data", {"name": "lastClick"}, ""], ["data", {"name": "lastDouble"}, ""],
    ["data", {"name": "ticks"}, 0], ["data", {"name": "once"}, 0], ["data", {"name": "hello"}, ""], ["data", {"name": "seen"}, 0],
    ["data", {"name": "why"}, ""], ["data", {"name": "why2"}, ""],
    ["data", {"name": "a", "on": {"saved": ["set!", "a", ["get", "$payload", "total"]]}}, 0],
    ["data", {"name": "b", "on": {"saved": ["set!", "b", ["str", "from ", "$from"]]}}, ""],
    ["data", {"name": "spin", "on": {"change": ["set!", "spun", ["+", "$spin", 1]]}}, 0],
    ["data", {"name": "spun", "on": {"change": ["set!", "spin", ["+", "$spun", 1]]}}, 0]
  ]
}
