# edgy's screens, shot by sweep.sh (see the goal-loop skill):
#   export CDP_COOKIE="$(.claude/goal-loop/serve.sh session 8791)"   # signed in (accounts mode)
#   sweep.sh http://127.0.0.1:8791 "$TMPDIR/sweep" <doc-id> [<doc-id> …]
# Screens marked --cookie none are shot signed out.
# The app scrolls inside these panes, not the page.
@pane .desk, .home, .records, .profile

signin            /signin               desktop --cookie none
signup            /signup               desktop --cookie none
phone-signin      /signin               phone --cookie none
signed-out-doc    /d/x                  desktop --cookie none

home              /                     desktop --full
shared-with-me    /?scope=shared        desktop --full
data              /data                 desktop --full
profile           /profile              desktop --full
phone-home        /                     phone
phone-profile     /profile              phone --scroll
# The documentation, served by the app (signed out too). Every docs page at every size: site/scripts/crawl.mjs.
docs-home         /docs/                desktop --cookie none
docs-page         /docs/cells/table/    desktop
phone-docs        /docs/cells/table/    phone --cookie none

{id}-edit         /d/{id}?view=edit     desktop --full
{id}-live         /d/{id}?view=live     desktop --full
{id}-page         /d/{id}?view=page     desktop --full
{id}-phone        /d/{id}?view=live     phone --scroll
{id}-phone-page   /d/{id}?view=page     phone
{id}              /d/{id}?view=page     pdf
